DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
FRONTEND_URL=http://127.0.0.1:3000

# Langfuse（可选，不配置则可观测性自动关闭）
# 先 docker compose up -d，然后在 http://localhost:3001 建项目拿 key
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
# 环境标签（default/production/…）：Langfuse UI 按环境筛选，E2E 回归会自动打 e2e 标签
LANGFUSE_TRACING_ENVIRONMENT=

